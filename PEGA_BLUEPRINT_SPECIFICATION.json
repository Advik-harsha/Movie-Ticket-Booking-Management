{
  "_meta": {
    "blueprintVersion": "2.1.0",
    "createdBy": "Harsh Maurya",
    "githubUsername": "Advik-harsha",
    "organization": "CineWave Entertainment",
    "platform": "Pega Infinity",
    "targetVersion": "8.7+",
    "lastUpdated": "2026-08-28",
    "description": "Advanced-level Pega Blueprint for Movie Ticket Booking Management application with complete lifecycle, SLAs, routing, correspondence, data models, and validation rules.",
    "notes": [
      "Import this file via App Studio > Build from Blueprint > Upload Blueprint.",
      "Ensure Pega Academy exercise environment is initialized before import.",
      "All class names follow the PegaRULES naming convention: <Org>-<Layer>-<Name>."
    ]
  },

  "application": {
    "name": "Movie Ticket Booking Management",
    "shortDescription": "End-to-end digital booking management for CineWave Entertainment theatres.",
    "version": "01-01-01",
    "organization": "CineWave",
    "division": "Entertainment",
    "unit": "Operations",
    "builtOnApplication": "Pega Platform",
    "builtOnVersion": "8.7",
    "accessGroups": [
      {
        "name": "CineWave:Customer",
        "roles": ["Customer"],
        "portal": "CineWave-Portal-CustomerPortal"
      },
      {
        "name": "CineWave:Staff",
        "roles": ["BookingAgent", "FulfillmentStaff", "Administrator"],
        "portal": "CineWave-Portal-StaffPortal"
      }
    ]
  },

  "personas": [
    {
      "name": "Customer",
      "description": "End customer requesting movie ticket booking.",
      "accessGroup": "CineWave:Customer"
    },
    {
      "name": "BookingAgent",
      "description": "Staff member verifying show availability and processing bookings.",
      "accessGroup": "CineWave:Staff"
    },
    {
      "name": "FulfillmentStaff",
      "description": "Back-office staff responsible for finalizing seat allocation and ticket generation.",
      "accessGroup": "CineWave:Staff"
    },
    {
      "name": "Administrator",
      "description": "System admin with full access to application configuration and reporting.",
      "accessGroup": "CineWave:Staff"
    }
  ],

  "caseTypes": [
    {
      "name": "Movie Ticket Request",
      "class": "CineWave-Work-MovieTicketRequest",
      "description": "Manages the complete lifecycle of a customer movie ticket booking from request to confirmation.",
      "prefix": "MTR",
      "defaultUrgency": 10,
      "statusMapping": [
        { "caseStatus": "New", "pxObjStatus": "Open-New" },
        { "caseStatus": "Availability Check", "pxObjStatus": "Open-InProgress" },
        { "caseStatus": "Pending Approval", "pxObjStatus": "Pending-Approval" },
        { "caseStatus": "Processing", "pxObjStatus": "Open-InProgress" },
        { "caseStatus": "Completed", "pxObjStatus": "Resolved-Completed" },
        { "caseStatus": "Cancelled", "pxObjStatus": "Resolved-Cancelled" }
      ],

      "sla": {
        "ruleName": "MovieTicketRequestSLA",
        "class": "CineWave-Work-MovieTicketRequest",
        "goal": {
          "interval": "1 Day",
          "urgencyIncrease": 20,
          "notifyAssignee": true
        },
        "deadline": {
          "interval": "2 Days",
          "urgencyIncrease": 30,
          "notifyAssignee": true,
          "notifySupervisor": true
        },
        "passedDeadline": {
          "interval": "4 Hours",
          "repeatCount": 3,
          "urgencyIncrease": 10
        }
      },

      "dataModel": {
        "customerFields": [
          { "name": "CustomerName",         "type": "Text(50)",    "required": true,  "label": "Customer Name" },
          { "name": "CustomerEmail",         "type": "Text(100)",   "required": true,  "label": "Email Address",        "validation": "ValidateEmailFormat" },
          { "name": "CustomerPhone",         "type": "Text(15)",    "required": true,  "label": "Phone Number",         "validation": "ValidatePhoneFormat" },
          { "name": "CustomerID",            "type": "Text(20)",    "required": false, "label": "Customer ID (Optional)" }
        ],
        "bookingFields": [
          { "name": "MovieName",             "type": "Text(100)",   "required": true,  "label": "Movie Name" },
          { "name": "Genre",                 "type": "Text(50)",    "required": false, "label": "Genre" },
          { "name": "ShowDate",              "type": "Date",        "required": true,  "label": "Show Date",            "validation": "ValidateShowDateFuture" },
          { "name": "ShowTime",              "type": "TimeOfDay",   "required": true,  "label": "Show Time" },
          { "name": "ShowType",              "type": "Text",        "required": true,  "label": "Show Type",            "pickList": ["Standard", "Premium", "IMAX", "4DX"] },
          { "name": "NumberOfTickets",       "type": "Integer",     "required": true,  "label": "Number of Tickets",    "validation": "ValidateTicketCount", "minimum": 1, "maximum": 10 },
          { "name": "TheatreLocation",       "type": "Text(100)",   "required": true,  "label": "Theatre Location" },
          { "name": "ScreenNumber",          "type": "Text(10)",    "required": false, "label": "Screen / Hall Number" }
        ],
        "availabilityFields": [
          { "name": "SeatCapacity",          "type": "Integer",     "required": false, "label": "Total Seat Capacity",  "readOnly": true },
          { "name": "AvailableSeatsCount",   "type": "Integer",     "required": true,  "label": "Available Seats",      "validation": "ValidateSeatAvailability" },
          { "name": "SeatAvailabilityStatus","type": "Text",        "required": true,  "label": "Availability Status",  "pickList": ["Available", "Houseful", "Limited"] },
          { "name": "AvailabilityCheckedBy", "type": "Text(50)",    "required": false, "label": "Verified By",          "defaultValue": ".pyAssignmentOperatorName" },
          { "name": "AvailabilityCheckedOn", "type": "DateTime",    "required": false, "label": "Verified At",          "defaultValue": ".pxCreateDateTime" }
        ],
        "pricingFields": [
          { "name": "TicketPrice",           "type": "Decimal",     "required": false, "label": "Unit Ticket Price",    "readOnly": true,  "note": "Set by SetTicketPricingDT data transform." },
          { "name": "TotalCost",             "type": "Decimal",     "required": false, "label": "Total Cost",           "readOnly": true,  "note": "Calculated by CalcTotalCost Declare Expression." },
          { "name": "DiscountPercent",       "type": "Decimal",     "required": false, "label": "Discount (%)",         "defaultValue": "0" },
          { "name": "FinalCost",             "type": "Decimal",     "required": false, "label": "Final Cost After Discount", "readOnly": true, "note": "Calculated by CalcFinalCost Declare Expression." },
          { "name": "Currency",              "type": "Text(5)",     "required": false, "label": "Currency",             "defaultValue": "USD" }
        ],
        "approvalFields": [
          { "name": "BookingStatus",         "type": "Text",        "required": true,  "label": "Booking Decision",     "pickList": ["Confirmed", "Cancelled"] },
          { "name": "CancellationReason",    "type": "Text(255)",   "required": false, "label": "Cancellation Reason",  "conditional": "BookingStatus == Cancelled" }
        ],
        "fulfillmentFields": [
          { "name": "TicketID",              "type": "Text(30)",    "required": true,  "label": "Ticket ID",            "note": "Auto-generated via SetTicketID Data Transform." },
          { "name": "SeatNumbers",           "type": "Text(100)",   "required": true,  "label": "Assigned Seat Numbers" },
          { "name": "BookingConfirmationStatus", "type": "Text",    "required": true,  "label": "Booking Confirmation", "pickList": ["Booked", "Pending", "Failed"], "defaultValue": "Booked" },
          { "name": "ProcessedBy",           "type": "Text(50)",    "required": false, "label": "Processed By",         "defaultValue": ".pyAssignmentOperatorName" },
          { "name": "ProcessedOn",           "type": "DateTime",    "required": false, "label": "Processed At",         "defaultValue": ".pxCreateDateTime" }
        ],
        "systemFields": [
          { "name": "CaseID",                "type": "Text(30)",    "readOnly": true,  "label": "Case ID",              "value": ".pyID" },
          { "name": "RoutedToQueue",         "type": "Text(50)",    "readOnly": true,  "label": "Routed To Queue" },
          { "name": "EscalationCount",       "type": "Integer",     "readOnly": true,  "label": "SLA Escalation Count", "defaultValue": "0" }
        ]
      },

      "stages": [
        {
          "name": "Initial Stage",
          "type": "Primary",
          "entryStatus": "New",
          "processes": [
            {
              "name": "Submit Ticket Request",
              "type": "Screen Flow",
              "steps": [
                {
                  "name": "Submit Movie Ticket Request",
                  "type": "Collect Information",
                  "persona": "Customer",
                  "viewName": "SubmitMovieTicketRequestView",
                  "layout": "TwoColumnLayout",
                  "sections": [
                    {
                      "heading": "Customer Information",
                      "fields": ["CustomerName", "CustomerEmail", "CustomerPhone", "CustomerID"]
                    },
                    {
                      "heading": "Booking Details",
                      "fields": ["MovieName", "Genre", "ShowDate", "ShowTime", "ShowType", "TheatreLocation", "ScreenNumber", "NumberOfTickets"]
                    }
                  ],
                  "validations": ["ValidateCustomerInfo", "ValidateBookingDetails"],
                  "preProcessing": ["InitializeCaseDefaults"]
                }
              ]
            }
          ],
          "exitCondition": "All required customer and booking fields completed and validated."
        },

        {
          "name": "Availability",
          "type": "Primary",
          "entryStatus": "Availability Check",
          "processes": [
            {
              "name": "Check Availability and Calculate Cost",
              "type": "Screen Flow",
              "steps": [
                {
                  "name": "Check Show Availability",
                  "type": "Collect Information",
                  "persona": "BookingAgent",
                  "viewName": "CheckShowAvailabilityView",
                  "sections": [
                    {
                      "heading": "Booking Summary (Read-Only)",
                      "fields": ["MovieName", "ShowDate", "ShowTime", "ShowType", "TheatreLocation", "NumberOfTickets"],
                      "readOnly": true
                    },
                    {
                      "heading": "Availability Details",
                      "fields": ["SeatCapacity", "AvailableSeatsCount", "SeatAvailabilityStatus"]
                    }
                  ],
                  "validations": ["ValidateSeatAvailability"],
                  "postProcessing": ["SetTicketPricingDT"]
                },
                {
                  "name": "Calculate Booking Cost",
                  "type": "Automation",
                  "subType": "Data Transform",
                  "ruleName": "SetTicketPricingDT",
                  "description": "Sets TicketPrice based on ShowType, then triggers Declare Expression to auto-calculate TotalCost and FinalCost.",
                  "logic": [
                    "if ShowType == 'Standard'  then TicketPrice = 12.00",
                    "if ShowType == 'Premium'   then TicketPrice = 20.00",
                    "if ShowType == 'IMAX'      then TicketPrice = 28.00",
                    "if ShowType == '4DX'       then TicketPrice = 35.00",
                    "Currency = 'USD'"
                  ]
                }
              ]
            }
          ],
          "declareExpressions": [
            {
              "name": "CalcTotalCost",
              "target": ".TotalCost",
              "expression": ".TicketPrice * .NumberOfTickets"
            },
            {
              "name": "CalcFinalCost",
              "target": ".FinalCost",
              "expression": ".TotalCost * (1 - (.DiscountPercent / 100))"
            }
          ],
          "exitCondition": "SeatAvailabilityStatus == 'Available' or 'Limited', and pricing calculated."
        },

        {
          "name": "Approval",
          "type": "Primary",
          "entryStatus": "Pending Approval",
          "processes": [
            {
              "name": "Customer Confirmation",
              "type": "Approve / Reject",
              "steps": [
                {
                  "name": "Review Booking Details",
                  "type": "Collect Information",
                  "persona": "Customer",
                  "viewName": "ReviewBookingDetailsView",
                  "sections": [
                    {
                      "heading": "Booking Summary",
                      "fields": ["CustomerName", "MovieName", "Genre", "ShowDate", "ShowTime", "ShowType", "TheatreLocation", "ScreenNumber"],
                      "readOnly": true
                    },
                    {
                      "heading": "Pricing Breakdown",
                      "fields": ["NumberOfTickets", "TicketPrice", "TotalCost", "DiscountPercent", "FinalCost", "Currency"],
                      "readOnly": true
                    },
                    {
                      "heading": "Confirm Your Booking",
                      "fields": ["BookingStatus", "CancellationReason"]
                    }
                  ],
                  "validations": ["ValidateBookingDecision"]
                }
              ],
              "transitions": [
                {
                  "condition": "BookingStatus == 'Confirmed'",
                  "nextStage": "Booking Execution"
                },
                {
                  "condition": "BookingStatus == 'Cancelled'",
                  "nextStage": "Resolution",
                  "status": "Resolved-Cancelled",
                  "postProcessing": ["SendCancellationNotification"]
                }
              ]
            }
          ],
          "exitCondition": "Customer has made a confirmed or cancelled decision."
        },

        {
          "name": "Booking Execution",
          "type": "Primary",
          "entryStatus": "Processing",
          "processes": [
            {
              "name": "Route and Process Booking",
              "type": "Screen Flow",
              "steps": [
                {
                  "name": "Route By Show Type",
                  "type": "Router",
                  "routerType": "DecisionTable",
                  "ruleName": "RouteByShowType",
                  "description": "Automatically assigns case to appropriate work queue based on ShowType.",
                  "routingTable": [
                    { "condition": "ShowType == 'Premium' OR ShowType == 'IMAX' OR ShowType == '4DX'", "workQueue": "PremiumShowQueue@CineWave" },
                    { "condition": "ShowType == 'Standard'", "workQueue": "StandardShowQueue@CineWave" }
                  ],
                  "postProcessing": ["RecordRoutedQueue"]
                },
                {
                  "name": "Process Ticket Booking",
                  "type": "Collect Information",
                  "persona": "FulfillmentStaff",
                  "viewName": "ProcessTicketBookingView",
                  "sections": [
                    {
                      "heading": "Booking Reference",
                      "fields": ["CaseID", "CustomerName", "MovieName", "ShowDate", "ShowTime", "ShowType", "TheatreLocation", "NumberOfTickets", "FinalCost"],
                      "readOnly": true
                    },
                    {
                      "heading": "Fulfillment Details",
                      "fields": ["TicketID", "SeatNumbers", "BookingConfirmationStatus", "ScreenNumber"]
                    }
                  ],
                  "preProcessing": ["SetTicketID"],
                  "validations": ["ValidateFulfillmentDetails"],
                  "postProcessing": ["SendBookingConfirmationEmail"]
                }
              ]
            }
          ],
          "exitCondition": "Ticket processed and confirmation email dispatched."
        },

        {
          "name": "Resolution",
          "type": "Resolution",
          "substages": [
            { "name": "Resolved-Completed", "entryCondition": "BookingConfirmationStatus == 'Booked'" },
            { "name": "Resolved-Cancelled", "entryCondition": "BookingStatus == 'Cancelled'" }
          ]
        }
      ],

      "rules": {
        "dataTransforms": [
          {
            "name": "InitializeCaseDefaults",
            "description": "Sets system default values when a new case is created.",
            "actions": [
              "Set .Currency = 'USD'",
              "Set .DiscountPercent = 0",
              "Set .BookingConfirmationStatus = 'Pending'",
              "Set .EscalationCount = 0"
            ]
          },
          {
            "name": "SetTicketPricingDT",
            "description": "Sets unit ticket price based on selected ShowType.",
            "actions": [
              "When ShowType == 'Standard'  -> Set .TicketPrice = 12.00",
              "When ShowType == 'Premium'   -> Set .TicketPrice = 20.00",
              "When ShowType == 'IMAX'      -> Set .TicketPrice = 28.00",
              "When ShowType == '4DX'       -> Set .TicketPrice = 35.00"
            ]
          },
          {
            "name": "SetTicketID",
            "description": "Auto-generates a unique Ticket ID from Case ID + Show Date.",
            "actions": [
              "Set .TicketID = Concatenate('TKT-', .pyID, '-', FormatDate(.ShowDate, 'YYYYMMDD'))"
            ]
          },
          {
            "name": "RecordRoutedQueue",
            "description": "Records the work queue the case was routed to.",
            "actions": [
              "Set .RoutedToQueue = .pyWorkQueue"
            ]
          }
        ],

        "declareExpressions": [
          {
            "name": "CalcTotalCost",
            "class": "CineWave-Work-MovieTicketRequest",
            "target": ".TotalCost",
            "expression": ".TicketPrice * .NumberOfTickets",
            "triggers": ["TicketPrice", "NumberOfTickets"]
          },
          {
            "name": "CalcFinalCost",
            "class": "CineWave-Work-MovieTicketRequest",
            "target": ".FinalCost",
            "expression": ".TotalCost * (1 - (.DiscountPercent / 100))",
            "triggers": ["TotalCost", "DiscountPercent"]
          }
        ],

        "validateRules": [
          {
            "name": "ValidateCustomerInfo",
            "description": "Ensures customer fields are correctly populated.",
            "checks": [
              { "condition": "IsBlank(.CustomerName)", "message": "Customer Name is required." },
              { "condition": "IsBlank(.CustomerEmail)", "message": "Email Address is required." },
              { "condition": "NOT IsValidEmail(.CustomerEmail)", "message": "Please enter a valid email address." },
              { "condition": "IsBlank(.CustomerPhone)", "message": "Phone Number is required." }
            ]
          },
          {
            "name": "ValidateBookingDetails",
            "description": "Ensures booking request fields are valid.",
            "checks": [
              { "condition": "IsBlank(.MovieName)", "message": "Movie Name is required." },
              { "condition": "IsBlank(.ShowDate)", "message": "Show Date is required." },
              { "condition": ".ShowDate < Today()", "message": "Show Date must be a future date." },
              { "condition": "IsBlank(.ShowTime)", "message": "Show Time is required." },
              { "condition": "IsBlank(.ShowType)", "message": "Show Type is required." },
              { "condition": ".NumberOfTickets < 1 OR .NumberOfTickets > 10", "message": "Number of tickets must be between 1 and 10." },
              { "condition": "IsBlank(.TheatreLocation)", "message": "Theatre Location is required." }
            ]
          },
          {
            "name": "ValidateSeatAvailability",
            "description": "Ensures sufficient seats are available for requested ticket count.",
            "checks": [
              { "condition": ".SeatAvailabilityStatus == 'Houseful'", "message": "Sorry, this show is currently houseful. Please select another show." },
              { "condition": ".AvailableSeatsCount < .NumberOfTickets", "message": "Insufficient seats available. Only @{.AvailableSeatsCount} seat(s) remaining for this show." }
            ]
          },
          {
            "name": "ValidateBookingDecision",
            "description": "Validates customer confirmation form.",
            "checks": [
              { "condition": "IsBlank(.BookingStatus)", "message": "Please confirm or cancel your booking." },
              { "condition": ".BookingStatus == 'Cancelled' AND IsBlank(.CancellationReason)", "message": "Please provide a reason for cancellation." }
            ]
          },
          {
            "name": "ValidateFulfillmentDetails",
            "description": "Ensures fulfillment staff provides all required booking details.",
            "checks": [
              { "condition": "IsBlank(.TicketID)", "message": "Ticket ID is required." },
              { "condition": "IsBlank(.SeatNumbers)", "message": "Assigned Seat Numbers are required." },
              { "condition": "IsBlank(.BookingConfirmationStatus)", "message": "Booking Confirmation Status is required." }
            ]
          }
        ],

        "decisionTables": [
          {
            "name": "RouteByShowType",
            "description": "Routes case to work queue based on ShowType.",
            "inputColumn": ".ShowType",
            "rows": [
              { "condition": "== 'Premium'",  "result": "PremiumShowQueue" },
              { "condition": "== 'IMAX'",     "result": "PremiumShowQueue" },
              { "condition": "== '4DX'",      "result": "PremiumShowQueue" },
              { "condition": "== 'Standard'", "result": "StandardShowQueue" },
              { "condition": "OTHERWISE",     "result": "StandardShowQueue" }
            ]
          }
        ],

        "correspondenceRules": [
          {
            "name": "BookingConfirmationNotification",
            "class": "CineWave-Work-MovieTicketRequest",
            "type": "Email",
            "subjectTemplate": "Movie Ticket Booking Confirmed - @{.pyID}",
            "recipientField": ".CustomerEmail",
            "trigger": "OnCaseResolution",
            "htmlTemplateFile": "CORRESPONDENCE_TEMPLATE.html",
            "dynamicFields": [".pyID", ".TicketID", ".CustomerName", ".MovieName", ".ShowDate", ".ShowTime", ".ShowType", ".TheatreLocation", ".ScreenNumber", ".NumberOfTickets", ".SeatNumbers", ".FinalCost", ".Currency"]
          },
          {
            "name": "BookingCancellationNotification",
            "class": "CineWave-Work-MovieTicketRequest",
            "type": "Email",
            "subjectTemplate": "Your Booking @{.pyID} Has Been Cancelled",
            "recipientField": ".CustomerEmail",
            "trigger": "OnCancelledResolution",
            "dynamicFields": [".pyID", ".CustomerName", ".MovieName", ".ShowDate", ".CancellationReason"]
          }
        ]
      }
    }
  ],

  "dataObjects": [
    {
      "name": "Movie",
      "class": "CineWave-Data-Movie",
      "description": "Reusable data object containing master movie catalogue information.",
      "storageType": "Pega database table",
      "properties": [
        { "name": "MovieID",          "type": "Text(20)",   "key": true,  "label": "Movie ID" },
        { "name": "MovieName",        "type": "Text(100)",  "key": false, "label": "Movie Name" },
        { "name": "Genre",            "type": "Text(50)",   "key": false, "label": "Genre" },
        { "name": "Language",         "type": "Text(30)",   "key": false, "label": "Language" },
        { "name": "DurationMinutes",  "type": "Integer",    "key": false, "label": "Duration (Minutes)" },
        { "name": "Rating",           "type": "Text(10)",   "key": false, "label": "Content Rating (U/UA/A)" },
        { "name": "Director",         "type": "Text(100)",  "key": false, "label": "Director" },
        { "name": "Cast",             "type": "Text(255)",  "key": false, "label": "Lead Cast" },
        { "name": "ReleaseDate",      "type": "Date",       "key": false, "label": "Release Date" },
        { "name": "PosterURL",        "type": "Text(255)",  "key": false, "label": "Poster Image URL" },
        { "name": "IsActive",         "type": "TrueFalse",  "key": false, "label": "Is Actively Showing", "defaultValue": true }
      ],
      "saveBehavior": "Save to Pega database on creation"
    },
    {
      "name": "Show",
      "class": "CineWave-Data-Show",
      "description": "Reusable data object storing show schedule and seat availability details.",
      "storageType": "Pega database table",
      "properties": [
        { "name": "ShowID",           "type": "Text(20)",   "key": true,  "label": "Show ID" },
        { "name": "MovieID",          "type": "Text(20)",   "key": false, "label": "Movie ID (FK)",         "foreignKey": "CineWave-Data-Movie.MovieID" },
        { "name": "ShowDate",         "type": "Date",       "key": false, "label": "Show Date" },
        { "name": "ShowTime",         "type": "TimeOfDay",  "key": false, "label": "Show Start Time" },
        { "name": "ShowType",         "type": "Text",       "key": false, "label": "Show Type",             "pickList": ["Standard", "Premium", "IMAX", "4DX"] },
        { "name": "TheatreLocation",  "type": "Text(100)",  "key": false, "label": "Theatre Location" },
        { "name": "ScreenNumber",     "type": "Text(10)",   "key": false, "label": "Screen / Hall" },
        { "name": "SeatCapacity",     "type": "Integer",    "key": false, "label": "Total Seat Capacity" },
        { "name": "AvailableSeats",   "type": "Integer",    "key": false, "label": "Available Seats (Live)" },
        { "name": "StandardPrice",    "type": "Decimal",    "key": false, "label": "Standard Ticket Price" },
        { "name": "PremiumPrice",     "type": "Decimal",    "key": false, "label": "Premium Ticket Price" },
        { "name": "IMAXPrice",        "type": "Decimal",    "key": false, "label": "IMAX Ticket Price" },
        { "name": "FourDXPrice",      "type": "Decimal",    "key": false, "label": "4DX Ticket Price" },
        { "name": "IsActive",         "type": "TrueFalse",  "key": false, "label": "Show Is Active", "defaultValue": true }
      ],
      "saveBehavior": "Save to Pega database on creation"
    },
    {
      "name": "Booking",
      "class": "CineWave-Data-Booking",
      "description": "Audit data object to store historical booking records for reporting.",
      "storageType": "Pega database table",
      "properties": [
        { "name": "BookingID",        "type": "Text(30)",   "key": true,  "label": "Booking / Ticket ID" },
        { "name": "CaseID",           "type": "Text(30)",   "key": false, "label": "Pega Case ID" },
        { "name": "ShowID",           "type": "Text(20)",   "key": false, "label": "Show ID" },
        { "name": "CustomerEmail",    "type": "Text(100)",  "key": false, "label": "Customer Email" },
        { "name": "SeatNumbers",      "type": "Text(100)",  "key": false, "label": "Seat Numbers" },
        { "name": "FinalCost",        "type": "Decimal",    "key": false, "label": "Total Amount Paid" },
        { "name": "BookingStatus",    "type": "Text",       "key": false, "label": "Booking Status" },
        { "name": "BookingTimestamp", "type": "DateTime",   "key": false, "label": "Booking Timestamp" }
      ]
    }
  ],

  "workQueues": [
    {
      "name": "PremiumShowQueue",
      "class": "CineWave",
      "description": "Dedicated queue for processing Premium, IMAX, and 4DX movie ticket requests requiring enhanced customer service.",
      "processors": ["FulfillmentStaff", "BookingAgent"],
      "maxCapacity": 50,
